{
    "python.defaultInterpreterPath": "${workspaceFolder}/../ce-mongo-x-ray/.venv/bin/python",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/../ce-mongo-x-ray/src"
    ],
    "ruff.lint.run": "onSave",
    "ruff.format": true,
    "editor.formatOnSave": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestPath": "${workspaceFolder}/../ce-mongo-x-ray/.venv/bin/pytest",
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "editor.rulers": [
        120
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    }
}
